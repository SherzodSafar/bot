# Bu faylni qo'lda to'ldirish shart emas — `npm run setup` o'zi yaratadi.

# Neon.tech dan olingan PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# BotFather dan olingan bot token
BOT_TOKEN=your_botfather_token

# Ixtiyoriy: kiritilsa, ngrok dastur bilan birga avtomatik ishga tushadi
NGROK_AUTHTOKEN=

# Ixtiyoriy: ngrok'ni o'zingiz ishga tushirsangiz, manzil avtomatik aniqlanadi
MINIAPP_URL=

PORT=4000
ADMIN_API_KEY=pizza_admin_2024
